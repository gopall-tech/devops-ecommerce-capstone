# E-Commerce Platform Environment Variables
# Copy this file to .env and fill in the values

# General
NODE_ENV=development
LOG_LEVEL=debug

# User Service
USER_SERVICE_PORT=3000
USER_DB_URL=postgresql://postgres:postgres@localhost:5432/users
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Product Service
PRODUCT_SERVICE_PORT=3001
PRODUCT_DB_URL=postgresql://postgres:postgres@localhost:5432/products
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# Cart Service
CART_SERVICE_PORT=3002
CART_REDIS_URL=redis://localhost:6379
CART_TTL=604800

# Payment Service
PAYMENT_SERVICE_PORT=3003
PAYMENT_DB_URL=postgresql://postgres:postgres@localhost:5432/payments
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
ENCRYPTION_KEY=your-encryption-key-32-chars-min

# Order Service
ORDER_SERVICE_PORT=3004
ORDER_DB_URL=postgresql://postgres:postgres@localhost:5432/orders
SNS_ORDER_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:orders

# API Gateway
API_GATEWAY_PORT=3005
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# AWS (for local development with LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT=http://localhost:4566

# Monitoring
XRAY_DAEMON_ADDRESS=localhost:2000
PROMETHEUS_ENABLED=true
